# Thermal label printer (Raspberry Pi deployment)
# PRINTER_DEVICE=/dev/usb/lp0
# CUPS_QUEUE=POSIFLOW58D
# PRINTER_USE_CUPS=false

# Azure AI Foundry / Azure OpenAI image generation
AZURE_OPENAI_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1
AZURE_OPENAI_IMAGE_DEPLOYMENT=gpt-image-2.5-flare
# Omit AZURE_OPENAI_API_KEY to use Entra ID (az login) instead.
AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# AZURE_OPENAI_IMAGE_SIZE=1024x1024
# AZURE_OPENAI_IMAGE_QUALITY=
# IMAGE_PROVIDER=azure

# OpenRouter (free) text + vision — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=z-ai/glm-5.2:free
OPENROUTER_VISION_MODEL=inclusionai/ling-3.0-flash-vl:free
# OPENROUTER_MAX_TOKENS=2048
# OPENROUTER_TEXT_FALLBACKS=
# AI_PROVIDER=openrouter
# VISION_PROVIDER=openrouter

# NVIDIA NIM text — https://build.nvidia.com (Sign In -> API Keys)
NVIDIA_API_KEY=
NVIDIA_TEXT_MODEL=meta/muse-glimmer-30b
# NVIDIA_MAX_TOKENS=2048
AI_PROVIDER=nvidia
